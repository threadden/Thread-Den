rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }

    // User accounts collection: customer credentials, profile, addresses, bank details
    match /users/{userId} {
      allow read, write: if true;
    }

    // Single admin account collection for Merchant Hub access
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Catalog articles / products: connected with Merchant Hub and Storefront
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders collection: checkout purchases and order history
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customer reviews collection: manually published from Merchant Hub
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}
