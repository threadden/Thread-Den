# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# AI STYLIST IMAGE ENGINE
# FREE option: Cloudflare Workers AI (about 80 images/day free, no credit card).
#   1. Sign up at dash.cloudflare.com
#   2. Account ID: shown on the Workers AI page ("Use REST API")
#   3. API token: "Create a Workers AI API Token" on the same page
# When both are set, the AI Stylist uses Cloudflare automatically.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Optional: better quality model:
# CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-2-klein-9b"
#
# Optional: force an engine ("cloudflare" or "gemini").
# IMAGE_PROVIDER="cloudflare"

# ---------------------------------------------------------------------------
# ORDER CONFIRMATION & PAYMENT BILL EMAIL / WHATSAPP / SMS INTEGRATIONS
# Configure credentials in Settings > Secrets (never stored in client UI).
#
# 1. EMAIL & TAX INVOICE BILL MAILER (SMTP via Nodemailer OR Resend API):
#    Option A (Gmail / Custom SMTP):
#    SMTP_HOST="smtp.gmail.com"
#    SMTP_PORT="465"
#    SMTP_SECURE="true"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
#    Option B (Resend HTTP API):
RESEND_API_KEY=""
RESEND_FROM=""
#
# 2. WHATSAPP ORDER CONFIRMATION (Meta WhatsApp Cloud API OR Twilio WhatsApp):
#    Option A (Meta Cloud API):
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
#    Option B (Twilio WhatsApp):
TWILIO_WHATSAPP_FROM=""
#
# 3. NORMAL SMS CONFIRMATION (Twilio SMS OR Fast2SMS):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
FAST2SMS_API_KEY=""

# ---------------------------------------------------------------------------
# RAZORPAY BILLING & PAYMENT GATEWAY (UPI & CARDS)
# IMPORTANT: Razorpay static links (razorpay.me/@handle) require customers to type
# the amount manually. To have Razorpay AUTOMATICALLY populate & lock the exact
# bill amount during checkout, configure your Razorpay API Keys in Settings > Secrets:
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
VITE_RAZORPAY_KEY_ID=""
# Optional fallback Merchant UPI ID (e.g. yourname@okicici) for exact-amount UPI QR/Intent:
MERCHANT_UPI_VPA=""
# Merchant Razorpay.me handle URL (manual-entry fallback when API keys are absent):
RAZORPAY_ME_URL="https://razorpay.me/@johnraj"

